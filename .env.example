# WealthWise — environment configuration template
# Copy to .env and fill in real values.  DO NOT commit .env with secrets.
#
# LLM + Langfuse keys arrive in Phase 2 — fields are kept here so .env stays
# stable and never needs a structural rename across phases.

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=glm
LLM_MODEL=glm-4.7
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
# cross-check second model + embeddings (SiliconFlow international site .com)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
CROSSCHECK_MODEL=deepseek-ai/DeepSeek-V3
# 第三陪审员：奇数陪审团才有「多数」可言（两个模型只有一致/平票两种结果）。
# 留空即回退两模型档。
THIRD_MODEL=inclusionAI/Ling-flash-2.0
# 关掉扩展思考。陪审员做的是闭集分类，实测 GLM-4.7 开着思考要 30–60s、约 1150
# completion tokens 才得出同一个结论，关掉后 2.4s、42 tokens。
LLM_DISABLE_THINKING=true
# 单个陪审员超时（秒）。deliberate() 并发轮询、等所有人。
LLM_TIMEOUT=60

# ── Embeddings ────────────────────────────────────────────────────────────────
# local = 离线哈希嵌入（零 key 零网络）；siliconflow = 真实嵌入 API。
# 注意：语料检索器目前固定用离线哈希嵌入建索引，改这里只影响 deps.embedder
# （预留给按次 RAG 索引），不会改变现有检索结果。
EMBED_PROVIDER=local
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIM=256

# ── Observability ─────────────────────────────────────────────────────────────
ENABLE_LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ── Data providers ────────────────────────────────────────────────────────────
# 真实模式 = 腾讯 + 新浪双源行情（多源共识）+ AkShare 宏观（LPR + 两家 CPI 发布方）
#          + 腾讯日K（动量/已实现波动）。离线模式单源，共识层照跑，置信封顶 0.5。
USE_REAL_PROVIDERS=false
SAMPLE_DATA_DIR=data/samples

# ── Equity ranking ────────────────────────────────────────────────────────────
# 多因子打分：价值(E/P、B/P) + 动量(60日、跳过最近5日) + 低波(已实现波动)
#   + 规模(log 市值) + 流动性(封顶换手率)；按市场做截面 z-score 后加权，
#   缺因子的标的按已有因子重归一，不因数据覆盖薄而被扣分。
# 关闭时走老规则：市值大的排前面，市值相同就看谁便宜。
#
# 默认关闭，理由写在 portfolio/factors.py：权重是按经验拍的、没在本候选池回测过，
# 而一个看起来很量化却没验证过的公式，比一条诚实好读的规则更糟。
# 打开后动量与波动需要真实 Provider 的日K（离线样例只凑得齐三因子）。
ENABLE_FACTOR_SCORING=false

# 两个行情源对同一标的报价分歧超容差（2%）时，是否把它排除出选股。
# 无论开关如何，分歧都会打标并进 trace —— 关掉只是不剔除，不是不记录。
DROP_ON_DATA_DISAGREEMENT=true

# ── Domain thresholds / guardrails ────────────────────────────────────────────
MAX_FX_EXPOSURE=0.5
MAX_LLM_JUDGMENTS=12
RISK_BUDGET_METHOD=risk_parity

# ── Cost accounting ───────────────────────────────────────────────────────────
# Blended $/1k tokens — set to your contract price
TOKEN_PRICE_PER_1K=0.0002

# ── Persistence ───────────────────────────────────────────────────────────────
# memory (default, diskless) | sqlite (one process) | postgres (several)
RUN_STORE=memory
# SQLite audit log path — only used when RUN_STORE=sqlite
RUN_STORE_PATH=data/runs.db
# libpq DSN — required when RUN_STORE=postgres; also needs pip install -e '.[pg]'
# RUN_STORE_DSN=postgresql://wealthwise:wealthwise@localhost:5432/wealthwise
