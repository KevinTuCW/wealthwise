# WealthWise — environment configuration template
# Copy to .env and fill in real values.  DO NOT commit .env with secrets.
#
# LLM + Langfuse keys arrive in Phase 2 — fields are kept here so .env stays
# stable and never needs a structural rename across phases.

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=glm
LLM_MODEL=glm-4.7
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
# cross-check second model + embeddings (SiliconFlow international site .com)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
CROSSCHECK_MODEL=deepseek-ai/DeepSeek-V3
# 第三陪审员：奇数陪审团才有「多数」可言（两个模型只有一致/平票两种结果）。
# 留空即回退两模型档。
THIRD_MODEL=inclusionAI/Ling-flash-2.0

# ── Observability ─────────────────────────────────────────────────────────────
ENABLE_LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ── Data providers ────────────────────────────────────────────────────────────
USE_REAL_PROVIDERS=false
SAMPLE_DATA_DIR=data/samples

# ── Domain thresholds / guardrails ────────────────────────────────────────────
MAX_FX_EXPOSURE=0.5
MAX_LLM_JUDGMENTS=12
RISK_BUDGET_METHOD=risk_parity

# ── Cost accounting ───────────────────────────────────────────────────────────
# Blended $/1k tokens — set to your contract price
TOKEN_PRICE_PER_1K=0.0002

# ── Persistence ───────────────────────────────────────────────────────────────
RUN_STORE=memory
# SQLite audit log path — only used when RUN_STORE=sqlite
RUN_STORE_PATH=data/runs.db
